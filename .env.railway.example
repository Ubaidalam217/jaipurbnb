# ---------------------------------------------------------------------------
# JaipurBnB - Railway environment variables
#
# Copy these into the Railway service's Variables tab. This file is a template
# only: it is committed to git, so it must never contain real secrets.
#
# Railway is being used as a staging/demo target. Hostinger shared hosting
# remains the final production deployment (see CLAUDE.md, Milestone 4).
# ---------------------------------------------------------------------------

APP_NAME=JaipurBnB
APP_ENV=production

# Generate with: php artisan key:generate --show
# Paste the full value including the "base64:" prefix.
APP_KEY=

APP_DEBUG=false

# Railway gives the service a domain like https://jaipurbnb-production.up.railway.app
# Set this to the real generated domain, no trailing slash.
APP_URL=https://your-app.up.railway.app

# ---------------------------------------------------------------------------
# Database
#
# Add a MySQL database to the Railway project. Railway injects the connection
# details automatically (DATABASE_URL / MYSQL_URL, plus MYSQLHOST, MYSQLPORT,
# MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD). config/database.php reads
# DATABASE_URL / MYSQL_URL as a fallback for DB_URL, so only DB_CONNECTION
# has to be set by hand.
#
# If the URL fallback does not resolve, set the discrete vars instead using
# Railway reference variables:
#   DB_HOST=${{MySQL.MYSQLHOST}}
#   DB_PORT=${{MySQL.MYSQLPORT}}
#   DB_DATABASE=${{MySQL.MYSQLDATABASE}}
#   DB_USERNAME=${{MySQL.MYSQLUSER}}
#   DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
# ---------------------------------------------------------------------------

DB_CONNECTION=mysql

# ---------------------------------------------------------------------------
# Admin account - created by AdminSeeder on boot (see nixpacks.toml start cmd).
# The seeder is idempotent and refuses to run with the placeholder password,
# so ADMIN_PASSWORD must be a real strong value or no admin is created.
# ---------------------------------------------------------------------------

ADMIN_EMAIL=admin@jaipurbnb.com
ADMIN_PASSWORD=
ADMIN_NAME="Admin User"

# ---------------------------------------------------------------------------
# Drivers - all database-backed so nothing depends on the container filesystem,
# which Railway wipes on every redeploy.
# ---------------------------------------------------------------------------

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# stderr so logs land in the Railway deploy log rather than storage/logs.
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ---------------------------------------------------------------------------
# Build-time - vite is a devDependency, so npm ci must install devDependencies
# or `npm run build` fails during the install phase.
# ---------------------------------------------------------------------------

NPM_CONFIG_PRODUCTION=false
NODE_ENV=development

# ---------------------------------------------------------------------------
# Razorpay (Milestone 3). Use test keys on Railway, live keys only on the
# Hostinger production deployment.
# ---------------------------------------------------------------------------

# RAZORPAY_KEY=
# RAZORPAY_SECRET=

# ---------------------------------------------------------------------------
# Mail - defaults to the log driver so nothing is sent from staging until
# the client supplies real SMTP credentials.
# ---------------------------------------------------------------------------

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@jaipurbnb.com"
MAIL_FROM_NAME="${APP_NAME}"
